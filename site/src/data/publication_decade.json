  "sql": [
    {
      "label": "Records by decade of publication",
      "sql": "SELECT org,\n       (CAST(substr(value, 8, 4) AS INTEGER) // 10) * 10 AS decade,\n       count(*) AS records\nFROM records\nWHERE field_tag = '008'\n  AND regexp_matches(substr(value, 8, 4), '^[0-9]{4}$')\n  AND CAST(substr(value, 8, 4) AS INTEGER) BETWEEN 1450 AND 2030\nGROUP BY org, decade\nORDER BY org, decade"
    }
  ]
