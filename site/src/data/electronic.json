  "sql": [
    {
      "label": "Top 856 link hosts per institution",
      "sql": "SELECT org, regexp_extract(lower(value), 'https?://([^/]+)', 1) AS host, count(*) AS n\nFROM records\nWHERE field_tag = '856' AND subfield_code = 'u' AND value LIKE 'http%'\nGROUP BY org, host"
