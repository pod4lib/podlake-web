      "label": "Titles held by a single institution",
      "sql": "SELECT org, count(*) AS unique_titles\nFROM (\n  SELECT any_value(org) AS org\n  FROM record_meta\n  GROUP BY goldrush_key\n  HAVING count(DISTINCT org) = 1\n)\nGROUP BY org\nORDER BY unique_titles DESC"
