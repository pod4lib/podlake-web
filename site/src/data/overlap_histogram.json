      "label": "Titles held by N institutions",
      "sql": "SELECT institutions, count(*) AS titles\nFROM (\n  SELECT goldrush_key, count(DISTINCT org) AS institutions\n  FROM record_meta\n  GROUP BY goldrush_key\n)\nGROUP BY institutions\nORDER BY institutions"
