  "sql": [
    {
      "label": "Titles per institution (the diagonal)",
      "sql": "SELECT org, count(DISTINCT goldrush_key) AS titles\nFROM record_meta\nGROUP BY org\nORDER BY org"
    },
    {
      "label": "Shared titles for each pair",
      "sql": "WITH holdings AS (SELECT DISTINCT org, goldrush_key FROM record_meta)\nSELECT a.org AS a, b.org AS b, count(*) AS shared\nFROM holdings a\nJOIN holdings b USING (goldrush_key)\nWHERE a.org < b.org\nGROUP BY a.org, b.org\nORDER BY shared DESC"
    }
  ],
