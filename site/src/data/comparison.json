      "sql": "WITH candidate AS (\n  SELECT org, pod_record_id,\n    upper(substr(trim(value), 1, 1)) AS category,\n    CASE\n      WHEN field_tag = '050' AND subfield_code = 'a' THEN 0\n      WHEN field_tag = '090' AND subfield_code = 'a' THEN 1\n      WHEN field_tag = '852' AND subfield_code = 'h' AND ind1 = '0' THEN 2\n      WHEN field_tag = '950' AND subfield_code = 'a' THEN 3\n      WHEN field_tag = '900' AND subfield_code = 'f' THEN 4\n      WHEN field_tag = '099' AND subfield_code = 'a' THEN 5\n      WHEN field_tag = '949' AND subfield_code = 'a' THEN 6\n    END AS priority\n  FROM records\n  WHERE ((field_tag = '050' AND subfield_code = 'a') OR (field_tag = '090' AND subfield_code = 'a') OR (field_tag = '852' AND subfield_code = 'h' AND ind1 = '0') OR (field_tag = '950' AND subfield_code = 'a') OR (field_tag = '900' AND subfield_code = 'f') OR (field_tag = '099' AND subfield_code = 'a') OR (field_tag = '949' AND subfield_code = 'a')) AND regexp_matches(upper(substr(trim(value), 1, 1)), '[A-HJ-NP-VZ]') AND NOT regexp_matches(upper(substr(trim(value), 1, 2)), '^Q[S-Z]')\n),\nfirst_match AS (\n  SELECT org, category\n  FROM candidate\n  QUALIFY row_number() OVER (PARTITION BY org, pod_record_id ORDER BY priority) = 1\n)\nSELECT org, category, count(*) AS n\nFROM first_match\nGROUP BY org, category",
